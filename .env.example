# Instagram display profile (the business returned by META_ACCESS_TOKEN is shown)
META_ACCESS_TOKEN=your_meta_access_token_here

# Google Business display profile and review QR destination
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here
GOOGLE_REVIEW_URL=https://g.page/r/your-review-link

# Spin to Win campaign settings (read by server/server.js and exposed as public UI config)
SPIN_CAMPAIGN_ENABLED=true
SPIN_CAMPAIGN_START=
SPIN_CAMPAIGN_END=
SPIN_LIMIT_PER_CUSTOMER=1
SPIN_CALL_TO_ACTION=Follow us or share a review to play
SPIN_REDEMPTION_INSTRUCTIONS=Show this screen to a team member to redeem. Valid for 30 days.

# Each enabled reward has an equal chance. Set SPIN_REWARD_N_ACTIVE=false to remove it.
SPIN_REWARD_1_LABEL=10% OFF
SPIN_REWARD_1_DESCRIPTION=Enjoy 10% off your next visit
SPIN_REWARD_1_COLOR=#0879f9
SPIN_REWARD_1_ACTIVE=true
SPIN_REWARD_2_LABEL=15% OFF
SPIN_REWARD_2_DESCRIPTION=Enjoy 15% off your next visit
SPIN_REWARD_2_COLOR=#00a9a8
SPIN_REWARD_2_ACTIVE=true
SPIN_REWARD_3_LABEL=20% OFF
SPIN_REWARD_3_DESCRIPTION=Enjoy 20% off your next visit
SPIN_REWARD_3_COLOR=#0862e9
SPIN_REWARD_3_ACTIVE=true
SPIN_REWARD_4_LABEL=FREE GIFT
SPIN_REWARD_4_DESCRIPTION=A little gift from us
SPIN_REWARD_4_COLOR=#8100e8
SPIN_REWARD_4_ACTIVE=true
SPIN_REWARD_5_LABEL=FREE ADD-ON
SPIN_REWARD_5_DESCRIPTION=Choose a complimentary add-on
SPIN_REWARD_5_COLOR=#7900eb
SPIN_REWARD_5_ACTIVE=true
SPIN_REWARD_6_LABEL=BUY 1 GET 1
SPIN_REWARD_6_DESCRIPTION=Buy one, get one on your next visit
SPIN_REWARD_6_COLOR=#e40083
SPIN_REWARD_6_ACTIVE=true
SPIN_REWARD_7_LABEL=BONUS POINTS
SPIN_REWARD_7_DESCRIPTION=Bonus points added to your rewards
SPIN_REWARD_7_COLOR=#00a9a8
SPIN_REWARD_7_ACTIVE=true
SPIN_REWARD_8_LABEL=TRY AGAIN
SPIN_REWARD_8_DESCRIPTION=Thanks for playing—come back soon
SPIN_REWARD_8_COLOR=#dc0076
SPIN_REWARD_8_ACTIVE=true
